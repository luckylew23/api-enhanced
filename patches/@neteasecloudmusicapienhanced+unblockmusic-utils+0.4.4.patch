+// 通用外链（music.163.com/song/media/outer/url）是网易云对未付费/试听歌下发的
+// "假解灰"链接，VIP 歌通常播不了。在遍历解灰时把它视为无效，继续试下一个真源。
+// 若某音源的 outer url 带真实可用 token 也可正常播放，但解灰场景下一律走 CDN 真源更稳。
+function isFakeSuccessUrl(url) {
+  return typeof url === 'string' && url.includes('music.163.com/song/media/outer/url');
