+
+// 部分音源（ddyr/unm/oi 等）返回的是 http:// 明文 126.net 链接。
+// 若播放器运行在 HTTPS 页面（网页端/Electron），浏览器混合内容策略会拦截 http 音频，
+// 表现为"有时播放资源获取失败"。统一把 http 升级为 https（126.net 两种协议 token 通用）。
+function toHttps(url) {
+  return typeof url === 'string' ? url.replace(/^http:\/\//i, 'https://') : url;
