{
  "version": 2,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "regions": ["hkg1"],
  "env": {
    "NODE_ENV": "production",
    "ENABLE_GENERAL_UNBLOCK": "true",
    "ENABLE_FLAC": "true"
  }
}
